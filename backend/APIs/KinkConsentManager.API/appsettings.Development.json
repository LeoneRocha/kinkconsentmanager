{
  "DatabaseProvider": "PostgreSQL",
  "Database": {
    "SkipInitialization": false
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "TokenConfigurations": {
    "Secret": "",
    "Issuer": "KinkConsentManager.API",
    "Audience": "KinkConsentManager.Client",
    "Minutes": 60,
    "DaysToExpiry": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:8082",
      "http://localhost:5173"
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
