# Template de variaveis de ambiente para execucao Docker do KinkConsentManager.API
# Copie este arquivo para .env (nunca versionado) antes de subir com docker compose.

ASPNETCORE_ENVIRONMENT=Development
DATABASE_PROVIDER=PostgreSQL
DATABASE_SKIP_INITIALIZATION=true

# Supabase PostgreSQL connection string (Direct Connection porta 5432 ou Session Pooler)
KINKCONSENT_CONNECTION_STRING=

# Chave HMAC-SHA512 (HS512): obrigatorio ter no minimo 64 bytes (64+ caracteres ASCII)
KINKCONSENT_TOKEN_SECRET=KinkConsentManagerLocalDockerTestingSecretKeyOnlyForDev2026_1234567890

# Opcional: Azure Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Opcional: imagem usada no docker-compose.prod.yml
KINKCONSENT_IMAGE=kinkconsentmanager-api:prod
