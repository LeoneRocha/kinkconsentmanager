{
    "compilerOptions": {
      "strict": true,
      "module": "esnext",
      "moduleResolution": "bundler",
      "target": "es6",
      "lib": ["ESNext", "dom", "dom.iterable"],
      "jsx": "react-jsx",
      "jsxImportSource": "preact",
      "paths": {
        "react": ["../node_modules/preact/compat/"],
        "react/jsx-runtime": ["../node_modules/preact/jsx-runtime"],
        "react-dom": ["../node_modules/preact/compat/"],
        "react-dom/*": ["../node_modules/preact/compat/*"]
      }
    },
    "exclude": ["kinklist.js"],
    "include": ["*", "**/*.ts", "**/*.{ts,tsx}"]
}
