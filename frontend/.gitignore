# ==============================================
# kinkconsentmanager - Global .gitignore
# ==============================================

# Compiled output / Angular
/dist
/tmp
/out-tsc
/bazel-out
/.angular/cache
/.jest-cache/
.sass-cache/
/connect.lock
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# Node
/node_modules
/node_modules/**
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Coverage directory used by tools like istanbul / vitest
/coverage
coverage/
*.lcov

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE and Editor files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/*
*.swp
*.swo
*~

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Temporary & Backup files
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# Archive files
*.zip
*.rar
*.7z
*.tar
*.gz

# Documentation build
docs/_build/
site/
*.db
*.vsidx
/.vs/
**/TestResults/
*.trx
*.lscache
sensitivedata.txt
artifacts/**
